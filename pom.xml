<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.github.jedwatson</groupId>
  <artifactId>classnames</artifactId>
  <!--
    NOT 2.5.1. The migration source is git commit abd6314 on `main`, which declares
    "version": "2.5.1" in package.json but contains an UNRELEASED refactor that changed
    behavior relative to the published npm 2.5.1:

        classNames(42)      npm 2.5.1 -> "42"    git HEAD -> ""
        classNames("a", 1)  npm 2.5.1 -> "a 1"   git HEAD -> "a"
        dedupe(130)         npm 2.5.1 -> "130"   git HEAD -> ""

    Publishing this as 2.5.1 would promise npm-2.5.1 behavior that this artifact does
    not have. 2.6.0-SNAPSHOT states the truth: unreleased work after 2.5.1.
    See TRUTH.md SS "Source provenance".
  -->
  <version>2.6.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>classnames</name>
  <description>A simple utility for conditionally joining classNames together.
    Java migration of the JavaScript package `classnames` (JedWatson/classnames),
    from git commit abd6314 - unreleased work after npm v2.5.1.</description>
  <url>https://github.com/JedWatson/classnames</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Jed Watson</name>
      <url>https://github.com/JedWatson</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/JedWatson/classnames.git</connection>
    <url>https://github.com/JedWatson/classnames</url>
  </scm>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <junit.version>5.11.4</junit.version>
    <jackson.version>2.18.2</jackson.version>
  </properties>

  <!--
    RUNTIME DEPENDENCIES: intentionally ZERO.

    The source package declares no `dependencies` (only devDependencies), and being
    dependency-free is a defining property of `classnames`. Everything this migration
    needs is in java.util, java.util.regex and java.lang.reflect.
    Adding Guava / Apache Commons / Jackson here would violate the dependency rule.

    TEST-ONLY: JUnit 5. No mocking framework is required because the source has no
    collaborators to mock - it is a pure function library.
  -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <!--
      TEST SCOPE ONLY - justification required by the dependency rule.

      DifferentialEquivalenceTest replays a corpus generated by the ORIGINAL JavaScript
      implementation (verification/generate-baseline.mjs) and compares outputs. That
      corpus is nested JSON, and the JDK ships no JSON parser.

      A hand-rolled parser was rejected: a bug in the harness would silently weaken the
      equivalence gate itself, which is the one thing that must be trustworthy.

      Scope is `test`, so the published artifact keeps ZERO runtime dependencies -
      the defining property of the source package.
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
      </plugin>

      <!--
        Line/branch coverage. Required by Checklist.md SIII-C, where the benchmark's
        "Coverage Analyst" reports line and branch coverage per repository.
        Build-time plugin only - contributes nothing to the published artifact.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
